    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@wdio/cli": "^9.32.0",
    "@wdio/cucumber-framework": "^9.32.0",
    "@wdio/devtools-service": "^10.11.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0"
  }
}
